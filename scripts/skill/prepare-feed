#!/usr/bin/env bash
# Internal Skill entry: consume the canonical published Feed snapshot.
set -euo pipefail

repo_root="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
python="$repo_root/.venv/bin/python"
if [[ ! -x "$python" ]]; then
    printf 'prepare-feed: missing %s; run uv sync --frozen --all-groups\n' "$python" >&2
    exit 2
fi

cd "$repo_root"
exec "$python" -m follow_the_money.feed.remote "$@"
