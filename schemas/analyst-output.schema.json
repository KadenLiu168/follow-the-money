{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/analyst-output.schema.json",
  "title": "Financial analyst structured output (OpenAI Structured Outputs subset)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_alias", "mechanisms", "implications", "reaction_attributions",
    "price_in", "indirect_indication", "asset_mappings", "alternatives",
    "watch_points", "scope", "fundamental_depth", "reversibility",
    "structural_horizon", "cn_hk_exposure", "us_next_session_exposure",
    "catalyst_calendar_ids", "audit_reasons"
  ],
  "properties": {
    "packet_alias": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,7}$" },
    "mechanisms": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 192 }
    },
    "implications": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 192 }
    },
    "reaction_attributions": {
      "type": "array",
      "maxItems": 9,
      "items": { "$ref": "#/$defs/reaction_attribution" }
    },
    "price_in": { "$ref": "#/$defs/price_in_assessment" },
    "indirect_indication": { "$ref": "#/$defs/indirect_indication" },
    "asset_mappings": {
      "type": "array",
      "maxItems": 9,
      "items": { "$ref": "#/$defs/asset_mapping" }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 192 }
    },
    "watch_points": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 192 }
    },
    "scope": { "enum": ["single_entity", "sector", "single_market", "cross_market", "unknown"] },
    "fundamental_depth": { "enum": ["headline", "operating_or_policy", "balance_sheet_or_liquidity", "systemic", "unknown"] },
    "reversibility": { "enum": ["high", "medium", "low", "effectively_irreversible", "unknown"] },
    "structural_horizon": { "enum": ["intraday", "days", "weeks", "months", "years_plus", "unknown"] },
    "cn_hk_exposure": { "enum": ["direct", "indirect", "none", "unknown"] },
    "us_next_session_exposure": { "enum": ["direct", "indirect", "none", "unknown"] },
    "catalyst_calendar_ids": { "type": "array", "items": { "type": "string" } },
    "audit_reasons": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/audit_reason" }
    }
  },
  "$defs": {
    "reaction_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_group", "attribution", "reference_aliases"],
      "properties": {
        "asset_group": { "enum": ["cn_hk_equities", "us_equities", "us_rates", "china_rates", "usd_fx", "industrial_commodities", "energy", "precious_metals", "crypto"] },
        "attribution": { "enum": ["direct", "likely", "concurrent", "unclear"] },
        "reference_aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    },
    "price_in_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "explanation", "reference_aliases"],
      "properties": {
        "status": { "enum": ["not_priced", "partial", "mostly_priced", "unclear"] },
        "explanation": { "type": "string", "maxLength": 192 },
        "reference_aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    },
    "indirect_indication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicated", "reference_aliases"],
      "properties": {
        "indicated": { "type": "boolean" },
        "reference_aliases": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    },
    "asset_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_group", "direction", "confidence", "horizon", "mechanism", "reference_aliases", "audit_reason"],
      "properties": {
        "asset_group": { "enum": ["cn_hk_equities", "us_equities", "us_rates", "china_rates", "usd_fx", "industrial_commodities", "energy", "precious_metals", "crypto"] },
        "direction": { "enum": ["positive", "negative", "mixed", "unclear"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "horizon": { "enum": ["intraday", "next_session", "days", "weeks", "months", "years_plus", "unknown"] },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 192 },
        "reference_aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "audit_reason": { "type": ["string", "null"], "maxLength": 192 }
      }
    },
    "audit_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": { "type": "string", "maxLength": 64 },
        "reason": { "type": "string", "maxLength": 192 }
      }
    }
  }
}
