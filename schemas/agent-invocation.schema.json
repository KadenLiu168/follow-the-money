{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/agent-invocation.schema.json",
  "title": "Follow the Money Agent invocation contract",
  "oneOf": [
    { "$ref": "#/$defs/request_audit_text" },
    { "$ref": "#/$defs/request_audit_claims" },
    { "$ref": "#/$defs/request_event_structure" },
    { "$ref": "#/$defs/success_audit_text" },
    { "$ref": "#/$defs/success_audit_claims" },
    { "$ref": "#/$defs/success_event_structure" },
    { "$ref": "#/$defs/error_response" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{40}$"
    },
    "fact_id": {
      "type": "string",
      "pattern": "^fact_[0-9a-f]{32}$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^(fam_single_evt_[0-9a-f]{40}|fam_[0-9a-f]{40})$"
    },
    "audit_text_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "audit_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "requires_direct_evidence",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identity"
        },
        "text": {
          "type": "string"
        },
        "requires_direct_evidence": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "audit_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "owning_event_id"],
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "owning_event_id": {
          "anyOf": [
            { "$ref": "#/$defs/identity" },
            { "type": "null" }
          ]
        }
      }
    },
    "audit_claims_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "submitted_claim_ids"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audit_claim"
          }
        },
        "submitted_claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audit_flow"
          }
        }
      }
    },
    "request_audit_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "input"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "audit.text"
        },
        "input": {
          "$ref": "#/$defs/audit_text_input"
        }
      }
    },
    "request_audit_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "input"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "audit.claims"
        },
        "input": {
          "$ref": "#/$defs/audit_claims_input"
        }
      }
    },
    "event_key_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_type",
        "origin_payload",
        "evidence_id",
        "subject",
        "predicate",
        "effective_time",
        "effective_precision",
        "value",
        "unit",
        "knowledge_available_at"
      ],
      "properties": {
        "entry_type": {
          "enum": ["FACT", "CLAIM"]
        },
        "origin_payload": {
          "enum": ["news", "macro_release", "policy", "filing", "flow", "positioning"]
        },
        "evidence_id": {
          "$ref": "#/$defs/identity"
        },
        "subject": {
          "$ref": "#/$defs/identity"
        },
        "predicate": {
          "$ref": "#/$defs/identity"
        },
        "effective_time": {
          "type": ["string", "null"]
        },
        "effective_precision": {
          "enum": ["instant", "date", "month", "year"]
        },
        "value": {
          "type": ["string", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "knowledge_available_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effective_precision": { "const": "instant" }
            }
          },
          "then": {
            "properties": {
              "effective_time": {
                "anyOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/timestamp" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effective_precision": { "const": "date" }
            }
          },
          "then": {
            "properties": {
              "effective_time": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effective_precision": { "const": "month" }
            }
          },
          "then": {
            "properties": {
              "effective_time": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effective_precision": { "const": "year" }
            }
          },
          "then": {
            "properties": {
              "effective_time": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}$"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "event_structure_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "evidence_ids",
        "entity_ids",
        "key_facts",
        "subject_zh"
      ],
      "properties": {
        "event_type": {
          "$ref": "#/$defs/identity"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "key_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event_key_fact"
          }
        },
        "subject_zh": {
          "$ref": "#/$defs/identity"
        },
        "company": {
          "$ref": "#/$defs/identity"
        },
        "form": {
          "$ref": "#/$defs/identity"
        },
        "story_family_peer_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          }
        },
        "coexisting_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": { "const": "filing" }
            }
          },
          "then": {
            "required": ["form"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["company"] },
                { "required": ["form"] }
              ]
            }
          }
        }
      ]
    },
    "request_event_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "input"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "event.structure"
        },
        "input": {
          "$ref": "#/$defs/event_structure_input"
        }
      }
    },
    "audit_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "detail", "severity"],
      "properties": {
        "claim_id": {
          "anyOf": [
            { "$ref": "#/$defs/identity" },
            { "type": "null" }
          ]
        },
        "category": {
          "enum": [
            "trading_instruction",
            "empty_inventory",
            "invalid_claim_id",
            "duplicate_claim_id",
            "outside_inventory",
            "missing_evidence",
            "flow_ownership"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["critical", "warning"]
        }
      }
    },
    "audit_result": {
      "oneOf": [
        { "$ref": "#/$defs/pass_result" },
        { "$ref": "#/$defs/fail_result" }
      ]
    },
    "pass_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "findings"],
      "properties": {
        "passed": {
          "const": true
        },
        "findings": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/audit_finding" },
              {
                "properties": {
                  "severity": {
                    "const": "warning"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "fail_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "findings"],
      "properties": {
        "passed": {
          "const": false
        },
        "findings": {
          "type": "array",
          "minContains": 1,
          "contains": {
            "allOf": [
              { "$ref": "#/$defs/audit_finding" },
              {
                "properties": {
                  "severity": {
                    "const": "critical"
                  }
                }
              }
            ]
          },
          "items": {
            "$ref": "#/$defs/audit_finding"
          }
        }
      }
    },
    "success_audit_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "result"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "audit.text"
        },
        "result": {
          "$ref": "#/$defs/audit_result"
        }
      }
    },
    "success_audit_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "result"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "audit.claims"
        },
        "result": {
          "$ref": "#/$defs/audit_result"
        }
      }
    },
    "event_time_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision"],
      "properties": {
        "value": {
          "type": ["string", "null"]
        },
        "precision": {
          "enum": ["instant", "date", "month", "year"]
        }
      }
    },
    "event_key_fact_effective_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "value", "precision"],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/fact_id"
        },
        "value": {
          "type": ["string", "null"]
        },
        "precision": {
          "enum": ["instant", "date", "month", "year"]
        }
      }
    },
    "key_fact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "evidence_id"],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/fact_id"
        },
        "evidence_id": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "event_structure_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "evidence_ids",
        "key_fact_ids",
        "fully_known_at",
        "story_family_id",
        "coexistence_pair_ids",
        "display_label",
        "economic_effective_time",
        "common_effective_time",
        "multiple_effective_times",
        "key_fact_effective_times",
        "key_fact_references"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "event_type": {
          "$ref": "#/$defs/identity"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "key_fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact_id"
          }
        },
        "fully_known_at": {
          "$ref": "#/$defs/timestamp"
        },
        "story_family_id": {
          "$ref": "#/$defs/family_id"
        },
        "coexistence_pair_ids": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/event_id"
            }
          }
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "economic_effective_time": {
          "$ref": "#/$defs/event_time_projection"
        },
        "common_effective_time": {
          "anyOf": [
            { "$ref": "#/$defs/event_time_projection" },
            { "type": "null" }
          ]
        },
        "multiple_effective_times": {
          "type": "boolean"
        },
        "key_fact_effective_times": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event_key_fact_effective_time"
          }
        },
        "key_fact_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/key_fact_reference"
          }
        }
      }
    },
    "success_event_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "result"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "operation": {
          "const": "event.structure"
        },
        "result": {
          "$ref": "#/$defs/event_structure_result"
        }
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "error"],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/invalid_json_error" },
            { "$ref": "#/$defs/unsupported_contract_version_error" },
            { "$ref": "#/$defs/unsupported_operation_error" },
            { "$ref": "#/$defs/invalid_request_error" },
            { "$ref": "#/$defs/execution_failure_error" }
          ]
        }
      }
    },
    "invalid_json_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "const": "invalid_json"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsupported_contract_version_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "const": "unsupported_contract_version"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unsupported_operation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "const": "unsupported_operation"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invalid_request_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "const": "invalid_request"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_failure_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "const": "execution_failure"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
