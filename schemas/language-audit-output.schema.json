{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/language-audit-output.schema.json",
  "title": "Language audit structured output (OpenAI Structured Outputs subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["covered_claim_ids", "findings"],
  "properties": {
    "covered_claim_ids": {
      "type": "array",
      "maxItems": 74,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "rationale", "reference_aliases"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": {
          "enum": [
            "causal_overclaim", "inference_as_fact", "unsupported_conclusion",
            "fact_modification", "trading_instruction", "wrong_language",
            "excessive_certainty", "missing_uncertainty"
          ]
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 192 },
        "reference_aliases": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    }
  }
}
