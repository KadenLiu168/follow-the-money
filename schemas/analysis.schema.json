{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/analysis.schema.json",
  "title": "Authoritative Analysis object (script-merged)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "event_id", "mechanisms", "implications",
    "reaction_attributions", "price_in", "money_flow", "asset_mappings",
    "alternatives", "watch_points", "scope", "fundamental_depth",
    "reversibility", "structural_horizon", "cn_hk_exposure",
    "us_next_session_exposure", "catalyst_calendar_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "analysis_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mechanisms": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 192 }
    },
    "implications": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 192 }
    },
    "reaction_attributions": {
      "type": "array",
      "maxItems": 9,
      "items": { "$ref": "#/$defs/reaction_attribution" }
    },
    "price_in": { "$ref": "#/$defs/price_in_assessment" },
    "money_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "direct_evidence_ids", "indirect_reference_aliases"],
      "properties": {
        "status": { "enum": ["confirmed", "indicated", "no_evidence"] },
        "direct_evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "indirect_reference_aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "asset_mappings": {
      "type": "array",
      "maxItems": 9,
      "items": { "$ref": "#/$defs/asset_mapping" }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 192 }
    },
    "watch_points": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 192 }
    },
    "scope": { "enum": ["single_entity", "sector", "single_market", "cross_market", "unknown"] },
    "fundamental_depth": { "enum": ["headline", "operating_or_policy", "balance_sheet_or_liquidity", "systemic", "unknown"] },
    "reversibility": { "enum": ["high", "medium", "low", "effectively_irreversible", "unknown"] },
    "structural_horizon": { "enum": ["intraday", "days", "weeks", "months", "years_plus", "unknown"] },
    "cn_hk_exposure": { "enum": ["direct", "indirect", "none", "unknown"] },
    "us_next_session_exposure": { "enum": ["direct", "indirect", "none", "unknown"] },
    "catalyst_calendar_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "reaction_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_group", "attribution", "evidence_ids"],
      "properties": {
        "asset_group": { "enum": ["cn_hk_equities", "us_equities", "us_rates", "china_rates", "usd_fx", "industrial_commodities", "energy", "precious_metals", "crypto"] },
        "attribution": { "enum": ["direct", "likely", "concurrent", "unclear"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "price_in_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "explanation", "evidence_ids"],
      "properties": {
        "status": { "enum": ["not_priced", "partial", "mostly_priced", "unclear"] },
        "explanation": { "type": "string", "maxLength": 192 },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "asset_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_group", "direction", "confidence", "horizon", "mechanism", "evidence_ids", "audit_reason"],
      "properties": {
        "asset_group": { "enum": ["cn_hk_equities", "us_equities", "us_rates", "china_rates", "usd_fx", "industrial_commodities", "energy", "precious_metals", "crypto"] },
        "direction": { "enum": ["positive", "negative", "mixed", "unclear"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "horizon": { "enum": ["intraday", "next_session", "days", "weeks", "months", "years_plus", "unknown"] },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 192 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "audit_reason": { "type": ["string", "null"], "maxLength": 192 }
      }
    }
  }
}
