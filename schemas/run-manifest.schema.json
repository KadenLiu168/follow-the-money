{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/run-manifest.schema.json",
  "title": "Run audit bundle terminal manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brief_run_id", "bundle_digest", "directory_id",
    "attempt_id", "feed_run_id", "mode", "brief_generated_at",
    "brief_completed_at", "application_build", "schema_fingerprints",
    "config_fingerprint", "prompt_fingerprints", "model_fingerprint",
    "members", "generation_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "brief_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "bundle_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "directory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "feed_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["normal", "degraded"] },
    "brief_generated_at": { "type": "string", "format": "date-time" },
    "brief_completed_at": { "type": "string", "format": "date-time" },
    "application_build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_version", "fingerprint", "files"],
      "properties": {
        "package_version": { "type": "string" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "git": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["sha", "dirty"],
          "properties": {
            "sha": { "type": "string" },
            "dirty": { "type": "boolean" }
          }
        }
      }
    },
    "schema_fingerprints": { "type": "object" },
    "config_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prompt_fingerprints": { "type": "object" },
    "model_fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "generation_status": { "const": "ready_for_commit" }
  }
}
