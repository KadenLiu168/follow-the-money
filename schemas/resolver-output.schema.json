{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/resolver-output.schema.json",
  "title": "Semantic resolver structured output (OpenAI Structured Outputs subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals", "unresolved_groups"],
  "properties": {
    "proposals": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/proposal" }
    },
    "unresolved_groups": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/unresolved_group" }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_alias", "position_alias", "event_type", "event_defining_fact_ids",
        "evidence_ids", "supporting_fact_ids", "entity_ids",
        "story_family_label", "coexistence_relations"
      ],
      "properties": {
        "component_alias": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,7}$" },
        "position_alias": { "type": "string", "pattern": "^p[0-9]{2}$" },
        "event_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "event_defining_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "supporting_fact_ids": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string" }
        },
        "entity_ids": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "story_family_label": { "type": "string", "pattern": "^(unknown|f[0-9]{1,2})$" },
        "coexistence_relations": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/coexistence_relation" }
        }
      }
    },
    "coexistence_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["other_proposal_alias", "relation"],
      "properties": {
        "other_proposal_alias": { "type": "string", "pattern": "^p[0-9]{2}$" },
        "relation": { "const": "distinct_material_development" }
      }
    },
    "unresolved_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_alias", "seed_fact_ids", "evidence_ids", "reason"],
      "properties": {
        "component_alias": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,7}$" },
        "seed_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "reason": {
          "enum": ["ambiguous", "insufficient_evidence", "unsupported_entity"]
        }
      }
    }
  }
}
