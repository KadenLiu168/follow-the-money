{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/verified-event-packet.schema.json",
  "title": "Verified event packet (input to the analyst shortlist)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "event_id", "feed_run_id",
    "verification_status", "key_fact_ids", "fully_known_at",
    "ledger", "evidence", "market_observations", "conflicts",
    "eligible_catalyst_calendar_ids", "completeness_findings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "feed_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "verification_status": { "enum": ["passed", "unresolved"] },
    "key_fact_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "fully_known_at": { "type": "string", "format": "date-time" },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id", "entry_type", "origin_payload", "evidence_id",
          "subject", "predicate", "value", "unit", "knowledge_available_at"
        ],
        "properties": {
          "fact_id": { "type": "string" },
          "entry_type": { "enum": ["FACT", "CLAIM", "OBSERVATION", "INFERENCE"] },
          "origin_payload": { "type": "string" },
          "evidence_id": { "type": "string" },
          "subject": { "type": "string" },
          "predicate": { "type": "string" },
          "effective_time": { "type": ["string", "null"], "format": "date-time" },
          "effective_precision": { "enum": ["instant", "date", "month", "year"] },
          "value": { "type": ["string", "null"] },
          "unit": { "type": ["string", "null"] },
          "knowledge_available_at": { "type": "string", "format": "date-time" },
          "source_families": { "type": "array", "items": { "type": "string" } },
          "tier_counts": { "type": "object" },
          "conflicts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "market_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation_ref" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "values", "reason"],
        "properties": {
          "fact_id": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "eligible_catalyst_calendar_ids": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 6
    },
    "completeness_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "finding"],
        "properties": {
          "fact_id": { "type": "string" },
          "finding": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_url", "tier", "knowledge_available_at", "provider_id"],
      "properties": {
        "evidence_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "tier": { "enum": ["Tier 1", "Tier 2", "Tier 3"] },
        "knowledge_available_at": { "type": "string", "format": "date-time" }
      }
    },
    "observation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "as_of", "value", "unit"],
      "properties": {
        "instrument_id": { "type": "string" },
        "as_of": { "type": "string", "format": "date-time" },
        "value": { "type": "string" },
        "unit": { "type": "string" }
      }
    }
  }
}
