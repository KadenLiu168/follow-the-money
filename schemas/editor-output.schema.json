{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/editor-output.schema.json",
  "title": "Editor structured output (OpenAI Structured Outputs subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["filled_slots"],
  "properties": {
    "filled_slots": {
      "type": "array",
      "maxItems": 61,
      "items": { "$ref": "#/$defs/filled_slot" }
    }
  },
  "$defs": {
    "filled_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_alias", "wording_fragment", "reference_aliases"],
      "properties": {
        "slot_alias": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,7}$" },
        "wording_fragment": { "type": "string", "minLength": 1, "maxLength": 192 },
        "reference_aliases": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    }
  }
}
