{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/feed-artifact.schema.json",
  "title": "Follow the Money typed Feed artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "domain",
    "items"
  ],
  "properties": {
    "schema_version": {
      "description": "Physical artifact major; the five-domain envelope is unchanged by logical Feed v5.",
      "enum": [
        2
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "domain": {
      "enum": [
        "news",
        "macro_release",
        "policy",
        "positioning",
        "filing"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/feed_item"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/domain_payloads"
    },
    {
      "properties": {
        "items": {
          "items": {
            "properties": {
              "payload": {
                "oneOf": [
                  {
                    "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/news"
                  },
                  {
                    "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/macro_release"
                  },
                  {
                    "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/policy"
                  },
                  {
                    "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/positioning"
                  },
                  {
                    "$ref": "https://follow-the-money/schemas/feed.schema.json#/$defs/filing"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "domain_payloads": {
      "allOf": [
        {
          "$ref": "#/$defs/news_artifact"
        },
        {
          "$ref": "#/$defs/macro_release_artifact"
        },
        {
          "$ref": "#/$defs/policy_artifact"
        },
        {
          "$ref": "#/$defs/positioning_artifact"
        },
        {
          "$ref": "#/$defs/filing_artifact"
        }
      ]
    },
    "news_artifact": {
      "if": {
        "properties": {
          "domain": {
            "const": "news"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "payload": {
                  "properties": {
                    "type": {
                      "const": "news"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "macro_release_artifact": {
      "if": {
        "properties": {
          "domain": {
            "const": "macro_release"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "payload": {
                  "properties": {
                    "type": {
                      "const": "macro_release"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "policy_artifact": {
      "if": {
        "properties": {
          "domain": {
            "const": "policy"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "payload": {
                  "properties": {
                    "type": {
                      "const": "policy"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "positioning_artifact": {
      "if": {
        "properties": {
          "domain": {
            "const": "positioning"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "payload": {
                  "properties": {
                    "type": {
                      "const": "positioning"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "filing_artifact": {
      "if": {
        "properties": {
          "domain": {
            "const": "filing"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "payload": {
                  "properties": {
                    "type": {
                      "const": "filing"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
