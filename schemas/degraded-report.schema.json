{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follow-the-money/schemas/degraded-report.schema.json",
  "title": "Deterministic degraded report (no LLM)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "brief_generated_at", "evidence_cutoff_at",
    "feed_run_id", "mode", "feed_health", "dashboard", "analytics",
    "unresolved_counts", "warnings", "audit_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brief_generated_at": { "type": "string", "format": "date-time" },
    "evidence_cutoff_at": { "type": "string", "format": "date-time" },
    "feed_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "const": "degraded" },
    "feed_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "warnings"],
      "properties": {
        "status": { "enum": ["healthy", "degraded"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dashboard": {
      "type": "array",
      "items": { "$ref": "#/$defs/dashboard_role" }
    },
    "analytics": { "type": "object" },
    "unresolved_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_blocks", "unresolved_groups", "unresolved_events"],
      "properties": {
        "candidate_blocks": { "type": "integer", "minimum": 0 },
        "unresolved_groups": { "type": "integer", "minimum": 0 },
        "unresolved_events": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "audit_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_audit"],
      "properties": {
        "script_audit": { "const": "passed" }
      }
    }
  },
  "$defs": {
    "dashboard_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "available", "display"],
      "properties": {
        "role_id": { "type": "string" },
        "available": { "type": "boolean" },
        "display": { "type": "string" },
        "return_pct": { "type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "anomalous": { "type": ["boolean", "null"] }
      }
    }
  }
}
