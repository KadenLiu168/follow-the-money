# Follow the Money — environment example
#
# Copy to `.env` (or export in the deployment environment) and fill values.
# Never commit real credentials. The repository never reads
# `~/.follow-the-money/config.json` implicitly; all configuration is explicit
# via --config / --output-root flags or repo defaults.

# --- Single OpenAI credential (required only for `brief` and `eval --mode live`) ---
# One compatible model powers all four LLM passes (resolver/analyst/editor/audit).
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional organization/project scoping for the Responses API.
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# --- Provider user agents (official sources expect a descriptive UA) ---
# SEC EDGAR requires a contact identifier in the user agent.
FOLLOW_THE_MONEY_USER_AGENT=follow-the-money/0.1 (+https://github.com/KadenLiu168/follow-the-money)

# --- Timeouts (seconds) ---
# Per-HTTP-attempt timeout for provider requests.
FOLLOW_THE_MONEY_HTTP_TIMEOUT=20
# Per-LLM-attempt timeouts per pass (resolver/analyst/editor/audit).
FOLLOW_THE_MONEY_LLM_RESOLVER_TIMEOUT=30
FOLLOW_THE_MONEY_LLM_ANALYST_TIMEOUT=45
FOLLOW_THE_MONEY_LLM_EDITOR_TIMEOUT=45
FOLLOW_THE_MONEY_LLM_AUDIT_TIMEOUT=30

# --- Paths ---
# Explicit output root holding feeds/ and the durable rate-state registry.
FOLLOW_THE_MONEY_OUTPUT_ROOT=feeds
# Local run-bundle root (audit evidence; never committed).
FOLLOW_THE_MONEY_RUNS_ROOT=runs

# --- Optional adapters (disabled by default; only with verified contracts) ---
# AKShare is an optional extra: `uv sync --extra akshare`.
# FOLLOW_THE_MONEY_ENABLE_AKSHARE=false
